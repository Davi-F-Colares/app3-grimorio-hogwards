<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Grimorio" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/burgundy</item>
        <item name="colorPrimaryVariant">@color/burgundy_escuro</item>
        <item name="colorOnPrimary">@color/pergaminho</item>
        <item name="colorSecondary">@color/ouro</item>
        <item name="colorOnSecondary">@color/fundo</item>
        <item name="android:statusBarColor">@color/fundo</item>
        <item name="android:navigationBarColor">@color/fundo</item>
        <item name="android:windowBackground">@color/fundo</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="materialButtonStyle">@style/Widget.Grimorio.Button</item>
        <item name="textInputStyle">@style/Widget.Grimorio.Campo</item>
    </style>

    <style name="Widget.Grimorio.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/burgundy</item>
        <item name="android:textColor">@color/pergaminho</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.Grimorio.Campo" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/stroke_campo</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxBackgroundColor">@color/campo_fundo</item>
        <item name="hintTextColor">@color/ouro</item>
        <item name="android:textColorHint">@color/pergaminho_fraco</item>
        <item name="errorTextColor">@color/erro</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>

    <style name="Texto.Rotulo" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textColor">@color/ouro</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Texto.Valor" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/pergaminho</item>
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">serif</item>
    </style>
</resources>
